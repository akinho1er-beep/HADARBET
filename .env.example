# ============================================================
# HADAR BetAnalytics — variables d'environnement
#
# 1. Copie ce fichier en « .env »   (Windows :  copy .env.example .env)
# 2. Remplis les valeurs ci-dessous
# 3. Lance simplement :  node server.js
#
# ⚠️ Le fichier .env ne doit JAMAIS être versionné sur Git (voir .gitignore)
# ============================================================

# ── Compte administrateur ────────────────────────────────────
# OBLIGATOIRE en production. Sans cette variable, un mot de passe
# aléatoire est généré au premier démarrage et affiché une seule
# fois dans les logs.
ADMIN_USER=HADAR_ADMIN
ADMIN_PASS=change-moi-en-mot-de-passe-solide

# ── Port d'écoute ────────────────────────────────────────────
# 3000 par défaut. Change-le si le port est déjà occupé.
PORT=3000

# ── Telegram (optionnel) ─────────────────────────────────────
# Le scraping public t.me/s/ fonctionne SANS token.
# Ce jeton ne sert que de solution de repli.
TELEGRAM_BOT_TOKEN=

# ── Analyse IA (optionnel mais recommandé) ───────────────────
# GROQ est le SEUL fournisseur d'IA utilisé par l'application.
# Clé gratuite en 1 minute : https://console.groq.com/keys
# Sans elle, les moteurs statistiques locaux fonctionnent normalement ;
# seule l'analyse IA enrichie (commentaire en langage naturel) est inactive.
GROQ_API_KEY=

# ⚠️ ANTHROPIC_API_KEY n'est PLUS utilisée. L'endpoint /analyze a été
# basculé sur Groq. Cette ligne ne sert que de rappel et peut être supprimée.

# ── Scraper bookmaker (optionnel) ────────────────────────────
# Puppeteer est désactivé par défaut : 1xBet bloque les IP cloud et
# Chromium consomme trop de mémoire. À n'activer qu'en local.
PUPPETEER_ENABLED=false
ONEXBET_BASE_URL=https://1xbet.bj

# Proxy si 1xBet bloque ton IP (format : http://user:pass@host:port)
PROXY_URL=

# ── Stockage ─────────────────────────────────────────────────
# Dossier des fichiers JSON. Sur Railway, pointe vers un volume
# persistant pour ne pas perdre les données à chaque déploiement.
# DATA_DIR=./data

# ── Sécurité ─────────────────────────────────────────────────
# CORS : origines autorisées à appeler l'API depuis un autre domaine.
#   (vide)                       = même origine uniquement — recommandé
#   https://mon-app.fr,https://x = liste blanche
#   *                            = tout autoriser — déconseillé
ALLOWED_ORIGINS=

# Rate-limit anti-force brute sur /api/auth/login
RATE_MAX_ATTEMPTS=8
RATE_WINDOW_MS=900000

# Durée de validité d'une session (12 h par défaut)
SESSION_TTL_MS=43200000
